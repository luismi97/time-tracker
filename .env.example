APP_NAME="Time Tracking"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8081
APP_TIMEZONE=America/Costa_Rica

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=time_tracking
DB_USERNAME=app_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Proxies cuya cabecera X-Forwarded-For se acepta para conocer la IP real del cliente.
TRUSTED_PROXIES=127.0.0.1,::1

# Habilita /migrate?token=... para ejecutar migraciones desde el navegador (minimo 16 caracteres).
# Dejalo vacio para desactivar esa URL.
MIGRATE_TOKEN=
