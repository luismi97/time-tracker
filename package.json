{
    "private": true,
    "description": "Compilacion de Tailwind CSS (solo herramienta de build, no forma parte del runtime de la app).",
    "scripts": {
        "build:css": "tailwindcss -i ./resources/css/input.css -o ./public/assets/css/app.css --minify",
        "watch:css": "tailwindcss -i ./resources/css/input.css -o ./public/assets/css/app.css --watch"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "tailwindcss": "^3.4.0"
    }
}
